{
  "name": "pixnais-studio",
  "productName": "Pixnais Studio",
  "version": "1.0.0",
  "description": "Pixel-art drawing program",
  "author": "naisaru",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.naisaru.pixnais",
    "files": ["main.js", "app/**/*", "build/icon.ico"],
    "win": { "target": ["portable"], "icon": "build/icon.ico" },
    "portable": { "artifactName": "PixnaisStudio-${version}.exe" }
  }
}
